# Example environment variables for watchmen-logger (RF-06)
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL credentials (referenced from logger.config.json as ${VAR_NAME})
LOGGER_DB_HOST=localhost
LOGGER_DB_PORT=5432
LOGGER_DB_NAME=watchmen_logger
LOGGER_DB_USER=logger_app
LOGGER_DB_PASSWORD=change-me

# Optional: full connection string instead of individual fields
# LOGGER_DB_CONNECTION_STRING=postgresql://logger_app:change-me@localhost:5432/watchmen_logger

# Monitoring UI basic auth
LOGGER_MONITORING_USER=admin
LOGGER_MONITORING_PASSWORD=change-me
