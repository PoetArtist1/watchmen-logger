{
  "name": "watchmen-logger",
  "version": "1.0.0",
  "description": "Self-hosted logging & monitoring middleware for REST APIs. Capture, store, and visualize HTTP requests with zero external dependencies.",
  "main": "src/index.js",
  "files": [
    "src/",
    "logger.config.example.json",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "WATCHMEN_DEV=1 nodemon --watch src --watch examples --ext js,json,css,html,sql --exec node examples/demo-server.js",
    "demo": "node examples/demo-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "logging",
    "monitoring",
    "middleware",
    "rest-api",
    "express",
    "http-logger",
    "dashboard",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PoetArtist1/watchmen-logger"
  },
  "bugs": {
    "url": "https://github.com/PoetArtist1/watchmen-logger/issues"
  },
  "homepage": "https://github.com/PoetArtist1/watchmen-logger#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "express": "^4.21.0",
    "nodemon": "^3.1.14",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
